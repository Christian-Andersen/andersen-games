{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on the first day of the month"],
    "recreateWhen": "always"
  },
  "pyenv": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Only refresh flake.lock via lockFileMaintenance; npm and uv lockfiles are already kept in sync by their package managers",
      "matchManagers": ["npm", "uv"],
      "lockFileMaintenance": {
        "enabled": false
      }
    },
    {
      "description": "Group Nix flake input (digest) updates into a single PR on the lockfile maintenance cadence",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["digest"],
      "groupName": "Nix flake inputs",
      "schedule": ["before 5am on the first day of the month"],
      "recreateWhen": "always"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the CPython version pinned by uv in .python-version files (with the +gil variant marker)",
      "fileMatch": ["(^|/)\\.python-version$"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)(?:\\+gil)?$"],
      "depNameTemplate": "python",
      "packageNameTemplate": "python/cpython",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "pep440",
      "autoReplaceStringTemplate": "{{newValue}}+gil"
    },
    {
      "customType": "regex",
      "description": "Track the pnpm version pinned in flake.nix permittedInsecurePackages",
      "fileMatch": ["(^|/)flake\\.nix$"],
      "matchStrings": ["\"(?<depName>pnpm)-(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm",
      "autoReplaceStringTemplate": "\"{{depName}}-{{newValue}}\""
    },
    {
      "customType": "regex",
      "description": "Keep the Biome schema URL version in biome.json in sync with the @biomejs/biome package",
      "fileMatch": ["(^|/)biome\\.json$"],
      "matchStrings": ["biomejs\\.dev/schemas/(?<currentValue>\\d+\\.\\d+\\.\\d+)/schema\\.json"],
      "depNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}